{
  "name": "cronicas-dos-imortais",
  "version": "8.1.0",
  "private": true,
  "description": "Mapa Vivo — Crônicas dos Imortais (RPG de navegador, arquivo HTML único)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build && vite build --mode test && node tools/check-js.ts dist/game.html",
    "build:game": "vite build",
    "build:test": "vite build --mode test",
    "dev": "vite --host",
    "preview": "vite preview --open /game.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/unit/diferencial.test.ts",
    "test:watch": "vitest --exclude tests/unit/diferencial.test.ts",
    "test:diferencial": "vitest run tests/unit/diferencial.test.ts",
    "test:browser": "playwright test --project build",
    "test:browser:ref": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "tools:check-js": "tsx tools/check-js.ts",
    "tools:fix-icon-holes": "tsx tools/fix-icon-holes.ts",
    "tools:slice-sheet": "node tools/slice-sheet.ts",
    "tools:sem-nocheck": "node tools/sem-nocheck.ts",
    "tools:personagem": "node tools/gerar-personagem.ts",
    "tools:heroina": "node tools/gerar-personagem.ts tools/modelos/heroina.json",
    "tools:animacoes": "node tools/gerar-animacoes.ts",
    "tools:variante": "node tools/gerar-variante.ts",
    "tools:coelho-fogo": "node tools/gerar-coelho-fogo.ts",
    "tools:armas": "node tools/gerar-armas.ts",
    "tools:chao": "node tools/gerar-chao.ts",
    "tools:cenario": "node tools/gerar-chao.ts tools/modelos/cenario.json",
    "tools:vila": "node tools/gerar-vila.ts",
    "tools:samurai": "node --max-old-space-size=6144 tools/reduzir-modelo.ts tools/modelos/samurai.json && node tools/gerar-animacoes.ts tools/modelos/samurai_animacoes.json",
    "tools:cavaleiros": "node tools/vestir-varios.ts cavaleiro_1 cavaleiro_2 cavaleiro_3 cavaleiro_4",
    "tools:bandidos": "node tools/vestir-varios.ts bandido_capuz bandido_colete bandido_bruto bandido_couraca",
    "tools:cabecas": "node --max-old-space-size=6144 tools/pintar-modelo.ts tools/modelos/cabecas.json",
    "tools:explorador": "node --max-old-space-size=6144 tools/reduzir-modelo.ts tools/modelos/explorador.json && node tools/gerar-animacoes.ts tools/modelos/explorador_animacoes.json",
    "tools:vestidos": "node tools/juntar-vestidos.ts",
    "tools:aparencias": "node --max-old-space-size=6144 tools/gerar-aparencias.ts",
    "tools:lider-bandidos": "node --max-old-space-size=6144 tools/pintar-modelo.ts tools/modelos/lider_bandidos.json && node tools/gerar-animacoes.ts tools/modelos/lider_bandidos_animacoes.json",
    "tools:tamandua": "node tools/gerar-tamandua.ts",
    "tools:bichos": "node tools/gerar-bichos.ts",
    "tools:icones-pedras": "node tools/gerar-icones-pedras.ts",
    "tools:voodi": "node tools/gerar-voodi.ts",
    "tools:voidd-letras": "node tools/gerar-voidd-letras.ts",
    "tools:titulo": "node tools/gerar-titulo.ts",
    "tools:marcador": "node tools/gerar-marcador.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/montserrat": "5.1.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "0.170.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "meshoptimizer": "^0.22.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "three": "0.170.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
